# ---- WhoIsMyCrush local environment ----
# Copy to .env and adjust. Never commit .env.

SECRET_KEY=change-me-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# DB_BACKEND=sqlite  -> uses db.sqlite3 (default, no setup needed)
# DB_BACKEND=postgres -> uses the PostgreSQL connection below
DB_BACKEND=sqlite
DB_NAME=whoismycrush
DB_USER=whoismycrush
DB_PASSWORD=whoismycrush
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- Matching rules ----
# Hard cap on active crush selections per student.
# Age gate for creating a campus identity.
MINIMUM_AGE=18

# ---- Email ----
# Set to 0 locally to silence the "it's mutual" alert.
MATCH_EMAILS_ENABLED=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@whoismycrush.local

# ---- Media / object storage ----
# local -> MEDIA_ROOT on disk
# s3 -> django-storages + boto3
MEDIA_BACKEND=local

# ---- Site ----
SITE_URL=http://127.0.0.1:8000